# Required: Google Gemini API key
GEMINI_API_KEY=your-key-here

# Model (any provider string LangChain's init_chat_model accepts)
LLM_MODEL=google_genai:gemini-3.8-flash
LLM_FALLBACK_MODEL=google_genai:gemini-2.5-flash

# Optional: LangSmith tracing. Absent key disables tracing silently.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=nl-insights-engine

# Limits
MAX_UPLOAD_MB=512
MAX_RESULT_ROWS=1000
QUERY_TIMEOUT_S=30
JOB_CONCURRENCY=4
AGENT_MAX_SQL_CALLS=6
AGENT_MAX_MODEL_CALLS=16
